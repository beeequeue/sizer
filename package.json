{
  "name": "@beequeue/sizer",
  "type": "module",
  "version": "3.0.0",
  "author": "BeeeQueue <adam@haglund.dev>",
  "license": "MIT",
  "packageManager": "pnpm@11.0.0-beta.3",
  "engines": {
    "node": ">=25"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,json5,yaml,yml,css,scss,md}": [
      "prettier --write"
    ]
  },
  "files": [
    "dist"
  ],
  "bin": {
    "sizer": "dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "7.7.3",
    "@changesets/changelog-github": "1.0.0-next.1",
    "@changesets/cli": "3.0.0-next.1",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/bytes": "3.1.5",
    "@types/node": "22.20.1",
    "bytes": "3.1.2",
    "eslint": "10.1.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "publint": "0.3.18",
    "sade": "1.8.1",
    "simple-git-hooks": "2.13.1",
    "tinyglobby": "0.2.15",
    "tinywhich": "1.0.0",
    "tsdown": "0.21.6",
    "typescript": "6.0.2"
  }
}
